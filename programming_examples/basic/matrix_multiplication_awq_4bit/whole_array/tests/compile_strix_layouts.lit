//
// Compile-smoke group 32 across every supported NPU2 column partition.  The
// narrower N tile keeps all scale/zero variants comfortably below 64 KiB.
//
// REQUIRES: ryzen_ai_npu2, chess
//
// RUN: %python %S/../whole_array.py --dev npu2 -M 512 -K 128 -N 32  -m 64 -k 128 -n 32 --group-size 32 --n-aie-cols 1 --dtype_out bf16 --xclbin-path=%t.1.xclbin --insts-path=%t.1.bin
// RUN: %python %S/../whole_array.py --dev npu2 -M 512 -K 128 -N 64  -m 64 -k 128 -n 32 --group-size 32 --n-aie-cols 2 --dtype_out bf16 --xclbin-path=%t.2.xclbin --insts-path=%t.2.bin
// RUN: %python %S/../whole_array.py --dev npu2 -M 512 -K 128 -N 128 -m 64 -k 128 -n 32 --group-size 32 --n-aie-cols 4 --dtype_out bf16 --xclbin-path=%t.4.xclbin --insts-path=%t.4.bin
// RUN: %python %S/../whole_array.py --dev npu2 -M 512 -K 128 -N 256 -m 64 -k 128 -n 32 --group-size 32 --n-aie-cols 8 --dtype_out bf16 --xclbin-path=%t.8.xclbin --insts-path=%t.8.bin
// RUN: %python %S/../whole_array.py --dev npu2 -M 512 -K 128 -N 64 -m 64 -k 128 -n 64 --group-size 128 --n-aie-cols 1 --dtype_out bf16 --trace_size=4096 --xclbin-path=%t.trace.xclbin --insts-path=%t.trace.bin
